        <name>mbedtls_platform_gmtime_r</name>
        <param>
          <type>const <ref refid="platform__time_8h_1a867121bdcdb8233c28c1cca32cf0839f" kindref="member">mbedtls_time_t</ref> *</type>
          <declname>tt</declname>

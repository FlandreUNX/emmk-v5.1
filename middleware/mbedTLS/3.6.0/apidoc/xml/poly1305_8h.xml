</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>key</parametername>
</parameternamelist>
<parameterdescription>
<para>The buffer containing the <computeroutput>32</computeroutput> Byte (<computeroutput>256</computeroutput> Bit) key.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><computeroutput>0</computeroutput> on success. </para><simplesectsep/><para>A negative error code on failure. </para></simplesect>
</para>        </detaileddescription>
